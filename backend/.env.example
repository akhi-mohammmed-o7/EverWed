# Odoo Connection
ODOO_URL=http://localhost:8069
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=

# Application
APP_NAME=EverWed
APP_VERSION=0.1.0
SECRET_KEY=replace-with-a-random-secret-before-deployment
DEBUG=true

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Persistent local application database (relative to backend/)
DATABASE_PATH=data/everwed.sqlite3
DATABASE_BUSY_TIMEOUT_MS=5000
SESSION_TTL_MINUTES=480
SEED_DEMO_DATA_ON_STARTUP=false

# Razorpay (keep all secret values in backend/.env, never in frontend code)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_TIMEOUT_SECONDS=10
